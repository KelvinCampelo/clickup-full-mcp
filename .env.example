# Example configuration for clickup-full-mcp.
# Put these in your MCP client's "env" block (or export them when running from a terminal).
# Never commit a real token.

# Required: personal token (pk_...) from ClickUp → Settings → Apps, or an OAuth access token.
CLICKUP_API_TOKEN=pk_xxx

# Default Workspace (team) ID, auto-filled into team_id / workspace_id.
# CLICKUP_WORKSPACE_ID=1234567

# "meta" (default: 4 tools for the whole API, search → describe → call) or "full" (one tool per endpoint).
# CLICKUP_TOOL_MODE=meta

# Limit which tools are exposed.
# CLICKUP_TOOLSETS=tasks,comments,lists,folders,spaces,time_tracking
# CLICKUP_READ_ONLY=false
# CLICKUP_DISABLED_TOOLS=delete_space,delete_folder
# CLICKUP_ENABLE_RAW_REQUEST=true

# Folders that file_path uploads may read from (unset = any readable file).
# CLICKUP_UPLOAD_ROOTS=/Users/me/Documents

# Limits.
# CLICKUP_MAX_RESPONSE_CHARS=100000
# CLICKUP_TIMEOUT_MS=60000
# CLICKUP_MAX_RETRIES=3

# Testing / proxies only. The token is sent to this host.
# CLICKUP_BASE_URL=https://api.clickup.com
